# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_ID=123456789  # Your Telegram user ID (comma-separated for multiple admins)

# Optional: Admin username
ADMIN_USERNAME=@your_username

# Network Configuration (required for Hugging Face Spaces, optional elsewhere)
# Hugging Face Spaces requires HTTPS proxy for outbound connections
# Get the proxy from HF Space Settings → Secrets (name: HTTPS_PROXY)
HTTPS_PROXY=https://proxy.example.com:8080

# HTTP proxy (optional, uses HTTPS_PROXY if not set)
HTTP_PROXY=http://proxy.example.com:8080

# No proxy (comma-separated hosts to bypass proxy)
NO_PROXY=localhost,127.0.0.1
